# Copie para .env.local e preencha. O Client ID NÃO é segredo (o fluxo PKCE não usa client secret),
# mas mesmo assim não commite seu .env.local.
VITE_SPOTIFY_CLIENT_ID=
# Precisa ser idêntico ao Redirect URI cadastrado no Spotify Developer Dashboard.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
