# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).
# Nunca commite .env.local.

# Client ID do app no Spotify Developer Dashboard. Não é segredo (PKCE, sem client secret).
VITE_SPOTIFY_CLIENT_ID=

# Segredo do servidor que cifra o cookie de sessão (refresh token). É secreto: mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No desenvolvimento local é opcional (sem ele, o login dura até reiniciar o servidor).
SESSION_SECRET=
