# Copy to .env.local for development, or set in your hosting provider. Never commit .env.local.

# Spotify app Client ID. Not a secret (PKCE, no client secret).
VITE_SPOTIFY_CLIENT_ID=

# Server secret that encrypts the session cookie (refresh token). At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in local development (without it, the login lasts until the dev server restarts).
SESSION_SECRET=
